{
  "sections": [
    {
      "key": "inspection",
      "title": { "en": "Work to inspect", "ar": "الأعمال المطلوب معاينتها" },
      "fields": [
        {
          "key": "description",
          "type": "textarea",
          "required": true,
          "label": { "en": "Description", "ar": "الوصف" },
          "help": {
            "en": "The work ready for inspection, such as the elements and the activity.",
            "ar": "الأعمال الجاهزة للمعاينة، مثل العناصر والنشاط."
          }
        },
        {
          "key": "specification_section",
          "type": "text",
          "required": false,
          "label": { "en": "Specification section", "ar": "بند المواصفات" }
        },
        {
          "key": "requested_for",
          "type": "datetime",
          "required": true,
          "label": { "en": "Requested for", "ar": "الموعد المطلوب" },
          "help": {
            "en": "When the work will be ready for inspection: a proposed time for the visit.",
            "ar": "متى تكون الأعمال جاهزة للمعاينة: موعد مقترح للزيارة."
          }
        }
      ]
    },
    {
      "key": "documents",
      "title": { "en": "Documents", "ar": "المستندات" },
      "fields": [
        { "key": "attachments", "type": "attachments", "required": false, "label": { "en": "Drawings and documents", "ar": "المخططات والمستندات" } },
        { "key": "photos", "type": "photos", "required": false, "label": { "en": "Photos", "ar": "الصور" } }
      ]
    },
    {
      "key": "references",
      "title": { "en": "References", "ar": "المراجع" },
      "fields": [
        {
          "key": "approved_submittals",
          "type": "work_item_ref",
          "required": false,
          "accepts": { "outcomes": ["A", "B"] },
          "label": { "en": "Approved submittals", "ar": "الاعتمادات الموافق عليها" },
          "help": {
            "en": "The submittals approved with Code A or B that this work relies on, such as its materials and drawings.",
            "ar": "الاعتمادات الموافق عليها بالرمز A أو B التي تعتمد عليها هذه الأعمال، مثل موادها ومخططاتها."
          }
        }
      ]
    },
    {
      "key": "classification",
      "title": { "en": "Classification", "ar": "التصنيف" },
      "fields": [
        { "key": "trade", "type": "trade", "required": true, "label": { "en": "Trade", "ar": "التخصص" } },
        { "key": "location", "type": "location", "required": true, "label": { "en": "Location", "ar": "الموقع" } },
        { "key": "scopes", "type": "scopes", "required": false, "label": { "en": "Scopes", "ar": "النطاقات" } }
      ]
    },
    {
      "key": "checklist",
      "title": { "en": "Checklist", "ar": "قائمة التحقق" },
      "fields": [
        {
          "key": "checklist_template",
          "type": "checklist_template",
          "required": true,
          "label": { "en": "Checklist Template", "ar": "قالب قائمة التحقق" },
          "help": {
            "en": "The Project's official checklist for this work, for the WIR's Trade. Its checks are copied onto the WIR and fixed once it is Submitted.",
            "ar": "قائمة التحقق المعتمدة في المشروع لهذه الأعمال، حسب تخصص طلب المعاينة. تُنسخ بنودها إلى الطلب وتثبت عند إرساله."
          }
        }
      ]
    }
  ],
  "pdf": {
    "disclaimer": {
      "en": "‹Disclaimer: the owner's text to come›",
      "ar": "‹إخلاء المسؤولية: نص المالك لاحقًا›"
    },
    "show_review_duration": false
  }
}
