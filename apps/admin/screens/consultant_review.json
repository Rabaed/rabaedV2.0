{
  "key": "consultant_review",
  "name": { "en": "Consultant review", "ar": "مراجعة الاستشاري" },
  "schema": {
    "sections": [
      {
        "key": "verification",
        "title": { "en": "Verification", "ar": "التحقق" },
        "fields": [
          {
            "key": "sample_checked",
            "type": "yes_no",
            "required": true,
            "label": { "en": "Sample checked", "ar": "تم فحص العينة" }
          },
          {
            "key": "matches_specification",
            "type": "yes_no",
            "required": true,
            "label": { "en": "Matches specification", "ar": "مطابق للمواصفات" }
          },
          {
            "key": "verification_note",
            "type": "textarea",
            "required": { "field": "matches_specification", "op": "=", "value": false },
            "maxLength": 4000,
            "label": { "en": "Verification note", "ar": "ملاحظة التحقق" },
            "help": {
              "en": "Say what does not match the specification. Only your Company reads this reply.",
              "ar": "اذكر ما لا يطابق المواصفات. لا يقرأ هذا الرد إلا شركتك."
            }
          }
        ]
      }
    ]
  },
  "internalFields": ["sample_checked", "matches_specification", "verification_note"]
}
