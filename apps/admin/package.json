{
  "name": "@rabaed/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./services": "./src/services.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "engineer:create": "tsx --env-file-if-exists=../../.env src/cli/create-engineer.ts",
    "form:publish": "tsx --env-file-if-exists=../../.env src/cli/publish-form.ts",
    "workflow:publish": "tsx --env-file-if-exists=../../.env src/cli/publish-workflow.ts",
    "defaults:publish": "tsx --env-file-if-exists=../../.env src/cli/publish-defaults.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@rabaed/auth": "workspace:*",
    "@rabaed/db": "workspace:*",
    "@rabaed/domain": "workspace:*",
    "@rabaed/mailer": "workspace:*",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@rabaed/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "intl-messageformat": "^11.2.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.1"
  }
}
