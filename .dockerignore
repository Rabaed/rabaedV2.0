# Never in an image: secrets, local state, and what the build recreates.
.env
.env.*
*.pem
*.key
.aws/
secrets/
.git/
**/node_modules/
**/.next/
**/cdk.out/
**/coverage/
**/*.tsbuildinfo
*.log

# Licensed fonts reach only the web build, through its own build context (Dockerfile).
packages/ui/fonts/
packages/ui/src/styles/arabic-font.css

# Not needed to run the app.
.claude/
.github/
design/
docs/
planning/
prototypes/
