{
  "name": "rabaed",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "docker compose up -d --wait db && pnpm db:setup && pnpm dev:apps",
    "dev:apps": "pnpm --parallel --filter @rabaed/api --filter @rabaed/web --filter @rabaed/worker run dev",
    "db:setup": "pnpm --filter @rabaed/db run setup",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:seam1": "vitest run --project seam1",
    "test:seam2": "vitest run --project seam2",
    "engineer:create": "pnpm --filter @rabaed/api run engineer:create"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.6",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
