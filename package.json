{
  "name": "rabaed",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "docker compose up -d --wait db mailpit && pnpm db:setup && pnpm dev:apps",
    "dev:apps": "pnpm --parallel --filter @rabaed/api --filter @rabaed/web --filter @rabaed/worker --filter @rabaed/admin run dev",
    "lane:env": "node scripts/lane-env.mjs",
    "db:setup": "pnpm --filter @rabaed/db run setup",
    "demo": "docker compose up -d --wait db mailpit && pnpm db:reset && pnpm demo:seed && pnpm dev:apps",
    "demo:seed": "pnpm --filter @rabaed/api run demo:seed",
    "db:reset": "pnpm --filter @rabaed/db run reset",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:seam1": "vitest run --project seam1",
    "test:seam2": "vitest run --project seam2",
    "test:stories": "pnpm --filter @rabaed/ui test:stories",
    "storybook": "pnpm --filter @rabaed/ui storybook",
    "test:infra": "vitest run --project infra",
    "test:mail": "vitest run --project mail",
    "engineer:create": "pnpm --filter @rabaed/admin run engineer:create"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@next/eslint-plugin-next": "^16.3.6",
    "@rabaed/eslint-plugin": "workspace:*",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
