{
  "name": "rabaed",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "docker compose up -d --wait db mailpit files && node scripts/pnpm.ts db:setup && node scripts/pnpm.ts dev:apps",
    "dev:apps": "node scripts/pnpm.ts --parallel --filter @rabaed/api --filter @rabaed/web --filter @rabaed/worker --filter @rabaed/admin run dev",
    "lane:env": "node scripts/lane-env.ts",
    "lanes:prune": "node scripts/lanes-prune.ts",
    "lanes:drop-dbs": "node scripts/lanes-drop-dbs.ts",
    "worktrees:clean": "node scripts/worktrees-clean.ts",
    "worktrees:prune": "node scripts/worktrees-prune.ts",
    "db:setup": "node scripts/pnpm.ts --filter @rabaed/db run setup",
    "demo": "docker compose up -d --wait db mailpit files && node scripts/pnpm.ts db:reset && node scripts/pnpm.ts demo:seed && node scripts/pnpm.ts dev:apps",
    "demo:seed": "node scripts/pnpm.ts --filter @rabaed/api run demo:seed",
    "db:reset": "node scripts/pnpm.ts --filter @rabaed/db run reset",
    "check:migrations": "node scripts/check-migrations.ts",
    "queue": "node scripts/queue-pr.ts",
    "lint": "eslint .",
    "typecheck": "node scripts/pnpm.ts -r run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:seam1": "vitest run --project seam1",
    "test:seam2": "vitest run --project seam2",
    "test:stories": "node scripts/pnpm.ts --filter @rabaed/ui test:stories",
    "test:stories:linux": "node scripts/test-stories-linux.ts",
    "storybook": "node scripts/pnpm.ts --filter @rabaed/ui storybook",
    "test:infra": "vitest run --project infra",
    "test:mail": "vitest run --project mail",
    "engineer:create": "node scripts/pnpm.ts --filter @rabaed/admin run engineer:create",
    "form:publish": "node scripts/pnpm.ts --filter @rabaed/admin run form:publish",
    "workflow:publish": "node scripts/pnpm.ts --filter @rabaed/admin run workflow:publish"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@next/eslint-plugin-next": "^16.3.6",
    "@rabaed/eslint-plugin": "workspace:*",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "type": "module"
}
