# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
credentials*.json
service-account*.json
secrets/
.aws/
*.tfstate
*.tfstate.*
.terraform/

# --- Licensed or bulky design material (kept locally only) ---
# Thmanyah font licence forbids hosting/redistributing the font files.
design/reference/claude-design/assets/fonts/thmanyah/*.woff2
design/reference/claude-design/assets/fonts/thmanyah/*.otf
design/reference/claude-design/uploads/
# The owner's Claude Design exports, dropped at the top of design/reference/: they embed
# the fonts, Thmanyah too (RP-663). Only the top level: the kit (claude-design/) and the
# committed reference pages in their own folders (sign-in/, submittal-panel/) stay tracked.
design/reference/*.[hH][tT][mM][lL]
# Private Thmanyah files supplied at build time (RP-211) and the CSS generated from them.
packages/ui/fonts/
packages/ui/src/styles/arabic-font.css
**/thmanyah*.woff2
**/thmanyah*.otf
**/thmanyah*.ttf
*.zip

# Signed-in browser states written by `pnpm demo:session` (RP-543); they hold live session cookies.
.demo-sessions/
# pnpm screens's PR screenshots (RP-531): published to screens-<branch>, never committed here.
.screens/
# pnpm verify's per-worktree lock (RP-996): the running verify's pid, start time and command; .verify.lock.* are its temp files.
.verify.lock
.verify.lock.*

# --- Tooling ---
node_modules/
# pnpm's store, when a sandboxed agent can't write to the drive root's store (RP-549).
.pnpm-store/
dist/
build/
coverage/
.turbo/
.next/
storybook-static/
.vitest/
.vercel/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.scratch/
design/reference/claude-design/assets/fonts/thmanyah/LICENSE.pdf

# Claude Code personal settings
.claude/settings.local.json
next-env.d.ts
*.tsbuildinfo

# AWS CDK synthesis output
cdk.out/
# Claude Code desktop app worktrees (other sessions' checkouts, incl. their .env)
.claude/worktrees/
# CDK context lookups name the AWS account; pin values in config.ts (RP-244).
cdk.context.json
