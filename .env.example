# Copy to .env for local development. Never commit .env.
# These are local-only placeholders for the Docker Compose database; real
# environments get their values from the secrets manager.

# One set of ports per worktree, so parallel sessions never share a database or a port.
# Generate this file with `pnpm lane:env <n>` instead of copying it by hand.
COMPOSE_PROJECT_NAME=rabaed
POSTGRES_PORT=5432
# Web dev server port (Next.js reads PORT).
PORT=3000

# Password for the Docker Compose Postgres superuser; must match DATABASE_SUPERUSER_URL.
# If you change it after the db-data volume exists, run `docker compose down -v` first.
POSTGRES_PASSWORD=local-dev-only
# Superuser (RDS master user in AWS): only creates roles and the database.
DATABASE_SUPERUSER_URL=postgres://postgres:local-dev-only@localhost:5432/postgres
# Owns the schema and runs migrations.
DATABASE_MIGRATOR_URL=postgres://rabaed_migrator:local-dev-only@localhost:5432/rabaed
# api and worker connect as this role; it cannot bypass row-level security.
DATABASE_APP_URL=postgres://rabaed_app:local-dev-only@localhost:5432/rabaed
# Rabaed Admin (Rabaed Engineers) connects as this role; it bypasses RLS and every use writes admin_action.
DATABASE_ADMIN_URL=postgres://rabaed_admin:local-dev-only@localhost:5432/rabaed

API_HOST=127.0.0.1
API_PORT=4000
# Where the web server reaches the API.
API_URL=http://127.0.0.1:4000
# Session cookie: set to true wherever the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
INVITATION_TTL_HOURS=72

WORKER_POLL_INTERVAL_MS=5000
