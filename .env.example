# Copy to .env for local development. Never commit .env.
# These are local-only placeholders for the Docker Compose database; real
# environments get their values from the secrets manager.

# One set of ports per worktree, so parallel sessions never share a database or a port.
# Generate this file with `pnpm lane:env <n>` instead of copying it by hand.
COMPOSE_PROJECT_NAME=rabaed
POSTGRES_PORT=5432
# Web dev server port (Next.js reads PORT).
PORT=3000
# Mailpit, the local mail catcher: its web page and the API the mailer sends through.
MAILPIT_PORT=8025
# The local file store (RustFS in docker-compose.yml).
FILE_STORE_PORT=9000

# Password for the Docker Compose Postgres superuser; must match DATABASE_SUPERUSER_URL.
# If you change it after the db-data volume exists, run `docker compose down -v` first.
POSTGRES_PASSWORD=local-dev-only
# Superuser (RDS master user in AWS): only creates roles and the database.
DATABASE_SUPERUSER_URL=postgres://postgres:local-dev-only@localhost:5432/postgres
# Owns the schema and runs migrations.
DATABASE_MIGRATOR_URL=postgres://rabaed_migrator:local-dev-only@localhost:5432/rabaed
# api and worker connect as this role; it cannot bypass row-level security.
DATABASE_APP_URL=postgres://rabaed_app:local-dev-only@localhost:5432/rabaed
# Rabaed Admin (apps/admin, Rabaed Engineers) connects as this role, and only it; it bypasses RLS and every use writes admin_action.
DATABASE_ADMIN_URL=postgres://rabaed_admin:local-dev-only@localhost:5432/rabaed
# In AWS each URL is built from parts instead: DATABASE_HOST, DATABASE_PORT, DATABASE_NAME,
# DATABASE_SSL_ROOT_CERT, DATABASE_SUPERUSER_USERNAME and one DATABASE_<ROLE>_PASSWORD per role.
# api and worker read the app password, and Rabaed Admin the admin one, from Secrets Manager
# when DATABASE_APP_SECRET_ARN / DATABASE_ADMIN_SECRET_ARN are set, so rotated passwords reach them.

API_HOST=127.0.0.1
API_PORT=4000
# Rabaed Admin (apps/admin): its own address, never the api's or web's (ADR 0010).
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4050
# The customer web: where Rabaed Admin's invitation emails send the Authorized Person, and the
# worker's notification emails link to.
WEB_URL=http://127.0.0.1:3000
# Where the web server reaches the API.
API_URL=http://127.0.0.1:4000
# Session cookie: set to true wherever the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
INVITATION_TTL_HOURS=72

WORKER_POLL_INTERVAL_MS=5000

# Email (packages/mailer). Locally and in CI every email goes to Mailpit, never out;
# in AWS the task gets MAIL_SES_CONFIGURATION_SET instead and sends through Amazon SES.
# The From address is config: a placeholder here, the verified sender in AWS (setup wizard).
MAIL_FROM=no-reply@rabaed.test
MAIL_CATCHER_URL=http://127.0.0.1:8025

# Documents' files (apps/api file-store.ts). Locally and in CI they go to the S3-compatible
# store in Docker, never to AWS; these keys are its local-only placeholders. In AWS the api
# task gets PROJECT_FILES_BUCKET and its role instead, and no FILE_STORE_* at all.
PROJECT_FILES_BUCKET=rabaed-project-files
FILE_STORE_ENDPOINT=http://127.0.0.1:9000
FILE_STORE_ACCESS_KEY_ID=rabaed-local
FILE_STORE_SECRET_ACCESS_KEY=local-dev-only
# The region the store's signatures name: any for the local store; `auto` on Cloudflare R2 (UAT).
FILE_STORE_REGION=us-east-1

# The Documental Record (apps/worker/src/record). RECORD_SEALING=local seals with a fresh in-memory
# test key and a timestamp stand-in, with the free fallback font; refused on ECS. In AWS the task gets
# RECORD_SEALING=kms with PDF_SEALING_KEY_ID, TIMESTAMP_AUTHORITY_URL and BUILD_ASSETS_BUCKET.
RECORD_SEALING=local
# Chromium is Playwright's (`pnpm --filter @rabaed/ui exec playwright install chromium`), else the
# system's Chrome; CHROMIUM_PATH names another.
# CHROMIUM_PATH=
# The PDF/A-3 validator of the checks before a record is published (RP-155): veraPDF, never inferred.
# VERAPDF=docker runs the image VERAPDF_IMAGE names (needs Docker; pinned to a tag or digest, never latest);
# VERAPDF=cli runs the program at VERAPDF_PATH (the worker image has it). Unset, or a docker without a pinned
# image, every record's checks wait and retry.
VERAPDF=docker
VERAPDF_IMAGE=verapdf/cli@sha256:d565095c67a083e693aebf7d1a15784007370571053fc1aa5b502665b9a78f9c

# Document limits; the defaults are 50 MB and PDFs, images, Office files, drawings, text and zip.
# DOCUMENT_MAX_MB=50
# DOCUMENT_CONTENT_TYPES=application/pdf,image/jpeg,image/png

# `pnpm claims` (RP-992) reads RP-603 through the Jira API. Set these in your own environment (or a
# gitignored file), never here: an Atlassian account email and an API token from id.atlassian.com.
# JIRA_EMAIL=
# JIRA_API_TOKEN=
